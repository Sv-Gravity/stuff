#!/usr/bin/env bash
# timewalk - jump between Linux versions without breaking your install.
#
# Supports Ubuntu (20.04 / 22.04 / 24.04) and RHEL-family (8 / 9 / 10).
#
# Two ways to "go back in time":
#   1. Kernel   - boot an older kernel that is installed on this machine.
#                 Real hardware, same system, just a different kernel.
#   2. Release  - open a full older OS userland (e.g. Ubuntu 20.04) in a
#                 container that shares your home folder. Your host is untouched.
#
# timewalk never does an in-place distro downgrade (24.04 -> 20.04 packages):
# neither Ubuntu nor Red Hat support that and it usually leaves the system
# unbootable.
#
# Usage: sudo ./timewalk        (kernel options need root; containers don't)

set -uo pipefail

RELEASES=(
  "Ubuntu 20.04|docker.io/library/ubuntu:20.04"
  "Ubuntu 22.04|docker.io/library/ubuntu:22.04"
  "Ubuntu 24.04|docker.io/library/ubuntu:24.04"
  "RHEL 8 (UBI)|registry.access.redhat.com/ubi8/ubi"
  "RHEL 9 (UBI)|registry.access.redhat.com/ubi9/ubi"
  "RHEL 10 (UBI)|registry.access.redhat.com/ubi10/ubi"
)

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
pause(){ read -rp "Press Enter to continue..." _; }
confirm(){ read -rp "$1 [y/N] " a; [[ $a =~ ^[Yy] ]]; }
need_root(){ [[ $EUID -eq 0 ]] || { warn "This option needs root. Re-run: sudo $0"; return 1; }; }

# ---------- detect host ----------
[[ -r /etc/os-release ]] || die "Can't read /etc/os-release"
. /etc/os-release
case " ${ID:-} ${ID_LIKE:-} " in
  *" ubuntu "*|*" debian "*) FAMILY=ubuntu ;;
  *" rhel "*|*" fedora "*|*" centos "*) FAMILY=rhel ;;
  *) die "Unsupported distro: ${PRETTY_NAME:-unknown}" ;;
esac

# ---------- kernels ----------
installed_kernels() {
  ls -1 /boot/vmlinuz-* 2>/dev/null | sed 's|/boot/vmlinuz-||' \
    | grep -v -e rescue -e '\.old$' | sort -Vr
}

pick() { # pick "prompt" item... -> echoes chosen item
  local prompt=$1; shift
  local PS3="$prompt (number, or 0 to go back): "
  select choice in "$@"; do
    [[ $REPLY == 0 ]] && return 1
    [[ -n ${choice:-} ]] && { echo "$choice"; return 0; }
  done
  return 1
}

set_default_kernel() {
  local ver=$1
  if [[ $FAMILY == rhel ]]; then
    grubby --set-default "/boot/vmlinuz-$ver" || return 1
  else
    local cfg=/boot/grub/grub.cfg sub entry
    # grub-set-default only sticks when GRUB_DEFAULT=saved
    if ! grep -q '^GRUB_DEFAULT=saved' /etc/default/grub; then
      cp /etc/default/grub /etc/default/grub.timewalk.bak
      if grep -q '^GRUB_DEFAULT=' /etc/default/grub; then
        sed -i 's/^GRUB_DEFAULT=.*/GRUB_DEFAULT=saved/' /etc/default/grub
      else
        echo 'GRUB_DEFAULT=saved' >> /etc/default/grub
      fi
      say "Set GRUB_DEFAULT=saved (backup: /etc/default/grub.timewalk.bak)"
    fi
    update-grub >/dev/null 2>&1 || return 1
    sub=$(grep -m1 "^submenu '" "$cfg" | cut -d"'" -f2)
    entry=$(grep "menuentry '" "$cfg" | grep -F "$ver" | grep -v recovery \
            | head -1 | sed "s/^[[:space:]]*menuentry '\([^']*\)'.*/\1/")
    [[ -n $entry ]] || { warn "No GRUB entry found for $ver"; return 1; }
    grub-set-default "${sub:+$sub>}$entry" || return 1
  fi
}

menu_switch_kernel() {
  need_root || return
  mapfile -t ks < <(installed_kernels)
  [[ ${#ks[@]} -gt 0 ]] || { warn "No kernels found in /boot"; return; }
  echo; say "Running now: $(uname -r)"
  local k; k=$(pick "Boot which kernel" "${ks[@]}") || return
  confirm "Make $k the default boot kernel?" || return
  if set_default_kernel "$k"; then
    say "Done. $k will boot next time."
    confirm "Reboot now?" && reboot
  else
    warn "Couldn't set the default kernel. Nothing was removed."
  fi
}

menu_download_kernel() {
  need_root || return
  local avail
  say "Looking up kernels in your package repos..."
  if [[ $FAMILY == rhel ]]; then
    mapfile -t avail < <(dnf -q list --available --showduplicates kernel 2>/dev/null \
      | awk '/^kernel/{print $2}' | sort -Vru)
  else
    apt-get update -qq
    mapfile -t avail < <(apt-cache search --names-only '^linux-image-[0-9].*-generic$' \
      | awk '{print $1}' | sed 's/linux-image-//' | sort -Vr | head -25)
  fi
  [[ ${#avail[@]} -gt 0 ]] || { warn "No extra kernels available from your repos."; return; }
  local k; k=$(pick "Install which kernel" "${avail[@]}") || return
  if [[ $FAMILY == rhel ]]; then
    dnf -y install "kernel-$k"
  else
    apt-get install -y "linux-image-$k" "linux-modules-$k" \
      "linux-modules-extra-$k" 2>/dev/null || apt-get install -y "linux-image-$k"
  fi && say "Installed. Use 'Switch kernel' to boot it."
}

# ---------- containers ----------
engine() {
  if command -v podman >/dev/null; then echo podman
  elif command -v docker >/dev/null; then echo docker
  else return 1; fi
}

ensure_engine() {
  ENG=$(engine) && return 0
  warn "No container engine found (podman or docker)."
  confirm "Install podman now?" || return 1
  need_root || return 1
  if [[ $FAMILY == rhel ]]; then dnf -y install podman; else apt-get update && apt-get install -y podman; fi
  ENG=$(engine)
}

release_names() { local r; for r in "${RELEASES[@]}"; do echo "${r%%|*}"; done; }
release_image() { local r; for r in "${RELEASES[@]}"; do [[ ${r%%|*} == "$1" ]] && echo "${r#*|}"; done; }

have_image() { $ENG image inspect "$1" >/dev/null 2>&1; }

menu_enter_release() {
  ensure_engine || return
  local names=() n img
  while read -r n; do
    img=$(release_image "$n")
    have_image "$img" && names+=("$n") || names+=("$n (will download)")
  done < <(release_names)
  n=$(pick "Walk into which release" "${names[@]}") || return
  n=${n% (will download)}; img=$(release_image "$n")
  have_image "$img" || $ENG pull "$img" || { warn "Download failed."; return; }
  say "Entering $n. Your home folder is at $HOME inside. Type 'exit' to come back."
  $ENG run --rm -it --hostname "timewalk-${n// /-}" \
    -v "$HOME:$HOME" -w "$HOME" -e HOME="$HOME" "$img" bash
}

menu_download_release() {
  ensure_engine || return
  local names n; mapfile -t names < <(release_names)
  n=$(pick "Download which release" "${names[@]}") || return
  $ENG pull "$(release_image "$n")" && say "$n is ready."
}

# ---------- main ----------
while true; do
  clear 2>/dev/null
  cat <<EOF
 === timewalk ===

 Host: ${PRETTY_NAME}   Kernel: $(uname -r)

  1) Walk into an older release (Ubuntu 20.04, RHEL 8, ...)
  2) Download more releases
  3) Switch boot kernel
  4) Download more kernels
  q) Quit
EOF
  read -rp "Choose: " opt
  case $opt in
    1) menu_enter_release ;;
    2) menu_download_release; pause ;;
    3) menu_switch_kernel; pause ;;
    4) menu_download_kernel; pause ;;
    q|Q) exit 0 ;;
  esac
done
